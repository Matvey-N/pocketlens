# Copy to .env and fill in. Never commit .env.
DB_USERNAME=pocketlens
DB_PASSWORD=change-me-strong-password
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-characters-0000
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Optional: Anthropic API key. Without it the app works, AI categorisation and the assistant are disabled.
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Optional: administrator account created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
GRAFANA_PASSWORD=change-me
# Production only: public host name for HTTPS (an sslip.io name works without buying a domain)
DOMAIN=
